# Base URL of the backend API (see backend/README section of the root README).
# Must include the backend's global prefix ("/api").
VITE_API_BASE_URL=http://localhost:3001/api

# 'mock' (default) — every screen reads from in-memory fixtures, no backend needed.
# 'api'  — Lead Management and login call the real backend at VITE_API_BASE_URL.
# Never put secrets in a VITE_ variable — everything here ships to the browser.
VITE_API_MODE=mock
