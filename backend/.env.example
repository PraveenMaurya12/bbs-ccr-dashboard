# Copy to backend/.env and fill in real local values. Never commit backend/.env.

# --- PostgreSQL (consumed by docker-compose.yml AND Prisma) ---
POSTGRES_DB=bbs_ccr_dashboard
POSTGRES_USER=bbs_ccr_app
# Local-dev-only placeholder — replace with your own value, never reuse in real environments.
POSTGRES_PASSWORD=changeme_local_dev_only
POSTGRES_PORT=5432

# Prisma reads this connection string directly (must match the POSTGRES_* values above).
DATABASE_URL="postgresql://bbs_ccr_app:changeme_local_dev_only@localhost:5432/bbs_ccr_dashboard?schema=public"

# --- App ---
NODE_ENV=development
PORT=3001

# Comma-separated list of allowed frontend origins (restrictive CORS for local dev).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# How many reverse-proxy hops in front of this server to trust when
# resolving the real client IP (req.ip) from X-Forwarded-For — 0 means
# "trust none" (correct for local dev, with no real proxy in front). The
# documented production target (see DEPLOYMENT.md) is a single Render Web
# Service — exactly one trusted edge-proxy hop — so set this to 1 there.
# Used for ConsentRecord.ipAddress and other audit/security client-IP
# capture ONLY — Signzy's own consent.consentIpAddress is a separate,
# permanently fixed value (see SIGNZY_FIXED_REQUEST_VALUES in
# signzy-http-client.ts) and never reads this or any other client-IP value.
TRUST_PROXY_HOPS=0

# --- Auth ---
# Generate real local secrets with: openssl rand -base64 48
JWT_ACCESS_SECRET=replace_with_a_long_random_local_dev_secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_local_dev_secret
JWT_REFRESH_TTL=7d
BCRYPT_SALT_ROUNDS=12

# --- Development-only seed accounts (see README "Development login") ---
# Used ONLY by `npm run seed`, and only when NODE_ENV is not "production".
# Never set/seed these in a production environment.
DEV_SEED_CCR_EMAIL=ccr.dev@bbs.example.test
DEV_SEED_CCR_PASSWORD=changeme_dev_seed_password
DEV_SEED_CCR_NAME=Dev CCR Agent

DEV_SEED_SUPERVISOR_EMAIL=supervisor.dev@bbs.example.test
DEV_SEED_SUPERVISOR_PASSWORD=changeme_dev_seed_password
DEV_SEED_SUPERVISOR_NAME=Dev Supervisor

# --- Public contact form (bade-bhaisab public website → /api/public/contact) ---
# The public site's own dev-server origins (and, in a deployed backend's
# real env, its production URL — e.g. https://bade-bhaisab.onrender.com).
# Kept separate from CORS_ORIGINS (the CCR dashboard's own origins).
PUBLIC_SITE_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176

# "mock" is the only implemented provider — see providers/mock-otp.provider.ts.
# It refuses to run when NODE_ENV=production. Setting this to anything else
# without first implementing OtpProvider for that provider throws at boot.
OTP_PROVIDER=mock

# Signs the short-lived (10 min) proof that an OTP was actually verified —
# required before a public lead submission is accepted. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
PUBLIC_OTP_TICKET_SECRET=replace_with_a_long_random_local_dev_secret

# Server-side pepper mixed into the PAN hash used only for duplicate
# detection — the raw PAN a visitor types is never stored anywhere.
PAN_HASH_PEPPER=replace_with_a_different_long_random_local_dev_secret

# --- Lead Detail "Documents" tab ---
# "local" (writes to DOCUMENT_LOCAL_STORAGE_DIR on this machine's disk) is
# the only implemented provider — fine for local dev, not for a real
# multi-instance production deployment. See DEPLOYMENT.md before deploying.
DOCUMENT_STORAGE_PROVIDER=local
DOCUMENT_LOCAL_STORAGE_DIR=storage/documents
# 10 MB
DOCUMENT_MAX_FILE_SIZE_BYTES=10485760
# Signs the short-lived (2 min) ticket that lets "View" open a document in a
# real new browser tab. Generate with:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
DOCUMENT_VIEW_TICKET_SECRET=replace_with_a_long_random_local_dev_secret

# --- Bureau credit report integration ---
# "mock" (default, safe everywhere — never calls a real bureau endpoint),
# "signzy" (Signzy Experian Lite — the primary production provider going
# forward; response field mapping is not yet verified against a real
# response, see signzy-response.mapper.ts), or "experian" (the legacy
# direct-Experian-SOAP integration, retained but no longer primary).
#
# CRITICAL BUSINESS RULE: at most ONE bureau call is ever made per BBS lead
# (see CreditReport.leadId's @unique constraint in schema.prisma and
# BureauReportService's own doc comment) — every real call costs money.
# There is no monthly refresh / report-expiry / retry-on-failure concept;
# once a call has been attempted for a lead, it is permanently consumed
# regardless of outcome (success, no-record, timeout, or an unmapped
# response). Do not reintroduce a validity-window or identity-based cache.
CREDIT_REPORT_PROVIDER=mock

# Signzy Experian Lite (primary) — never commit a real API key.
SIGNZY_API_BASE_URL=https://api.signzy.app
SIGNZY_API_KEY=
SIGNZY_REQUEST_TIMEOUT_MS=20000
# NOTE: consent.consentIpAddress is NOT configured here or anywhere in env —
# it is a permanent, hardcoded constant ("192.168.5.90") in
# SIGNZY_FIXED_REQUEST_VALUES (signzy-http-client.ts), sent unconditionally
# on every request regardless of environment, NODE_ENV, or this machine's
# real network/egress IP. There is deliberately no env var for it.

# Legacy direct Experian SOAP integration (retained, no longer primary).
EXPERIAN_SOAP_ENDPOINT=https://connect.experian.in:8443/ngwsconnect/ngws
EXPERIAN_SOAP_NAMESPACE=http://nextgenws.ngwsconnect.experian.com
# Provided by the Experian integration team — never commit real values.
EXPERIAN_XML_USER=
EXPERIAN_XML_PASSWORD=
EXPERIAN_REQUEST_TIMEOUT_MS=20000

# --- AI-assisted analysis insights (Gemini / Claude) ---
# "mock" (default), "gemini", or "claude". Advisory-only output — never a
# finalized decision by itself (see modules/analysis/providers/ai-provider.interface.ts).
AI_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_REQUEST_TIMEOUT_MS=120000
GEMINI_THINKING_LEVEL=low

# Claude (Anthropic Messages API). Only ANTHROPIC_WORKSPACE_ID is
# conditional — required for a user-scoped key (sk-ant-usr-...), not for a
# standard workspace/organization key (sk-ant-api03-...).
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
CLAUDE_REQUEST_TIMEOUT_MS=120000
# "low"|"medium"|"high"|"xhigh"|"max" — the real Messages API output_config.effort
# parameter, NOT Claude Code's own CLI effort setting.
CLAUDE_EFFORT=medium
# max_tokens on the Messages API request. Keep this generous: the
# structured-JSON prompts this provider serves can need more than a few
# thousand output tokens, and a response truncated by too low a limit is
# rejected outright (never parsed as partial JSON) — see claude-ai-provider.ts.
CLAUDE_MAX_OUTPUT_TOKENS=16384
ANTHROPIC_WORKSPACE_ID=

# --- Financial Analysis thresholds (Pilot V1 — requires Credit/Risk/Compliance sign-off before production) ---
# See config/configuration.ts's financialAnalysis block for what each one does.
FINANCIAL_LOW_BALANCE_THRESHOLD_RUPEES=1000
FINANCIAL_LARGE_TRANSACTION_MINIMUM_RUPEES=25000
FINANCIAL_LARGE_TRANSACTION_INCOME_MULTIPLIER=0.5
FINANCIAL_RECURRING_INCOME_MIN_MONTHS=3
FINANCIAL_RECURRING_INCOME_TOLERANCE=0.15
FINANCIAL_RECURRING_DEBT_MIN_MONTHS=2
FINANCIAL_RECURRING_DEBT_TOLERANCE=0.05
FINANCIAL_CREDIT_CORRELATION_TOLERANCE=0.1
FINANCIAL_EXCEPTIONAL_MONTH_MULTIPLIER=1.5
# COMPLIANCE-CRITICAL: comma-separated list of BBS/affiliate legal names + known
# narration variants. Empty by default (this module never hardcodes a specific
# employer name into source code — that would bake one deployment's fact into
# general policy). RELATED_PARTY_EMPLOYER can NEVER fire until this is populated.
# Per the v4.0 spec's own §6.7/§11.7 worked example, the real entity is BBS's own
# parent NBFC — update with its verified legal name and bank-narration variants.
FINANCIAL_RELATED_PARTY_EMPLOYER_NAMES=Golden Legand Leasing & Finance Ltd,Golden Legand Leasing,GoldnLegand,GLLFL
# Data Quality Score cap applied when BUSINESS_PERSONAL_MIXED is flagged (v4.0 spec §12.2's 5th named cap).
FINANCIAL_DATA_QUALITY_BUSINESS_PERSONAL_MIXED_CAP=78

# --- Cohort Engine thresholds (Pilot V1 — requires Credit/Risk/Compliance sign-off before production) ---
# See config/configuration.ts's cohortEngine block for what each one does.
COHORT_OVERDUE_CAPACITY_TRIGGER_RUPEES=100000
COHORT_ENQUIRY_BURST_THRESHOLD_30D=4
COHORT_STACKING_INDEX_PER_YEAR=15
COHORT_ACTIVE_OVERDUE_RATIO_THRESHOLD=0.60
COHORT_STRESSED_CAPACITY_RATIO_MAX=0.10
COHORT_TIGHT_CAPACITY_RATIO_MAX=0.20
COHORT_STABILISATION_COVERAGE_STRONG_MIN=1.25
COHORT_STABILISATION_COVERAGE_MINIMUM=1.00
COHORT_RULE_VERSION=BBS_COHORT_V1.0

# --- Plan Engine (Pilot V1) ---
# See config/configuration.ts's planEngine block for what each one does.
PLAN_REVIEW_CADENCE_DAYS=30,60,90
PLAN_TEMPLATE_REGISTRY_VERSION=BBS_PLAN_V1.0
